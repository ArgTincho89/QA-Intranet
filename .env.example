# Orden de resolución: variable de shell -> .env.<entorno> -> .env
# El entorno se elige con `npm run test:dev|pre|pro` (o la variable TEST_ENV).

# URL de la pantalla bajo prueba (obligatoria)
BASE_URL=https://intranetdev.seidor.com/home

# Opcional: "1" fuerza Chrome sin ventana. OJO: Cloudflare suele bloquear el modo headless.
HEADLESS=

# Opcional: reintentos por escenario (por defecto 1)
RETRY=
